<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Benzene.Patterns.Streaming.TickPipeline</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Benzene.AspNet.Core" />
    <!-- StreamContext, UseStream, Window, PartitionBy and IStreamCheckpointer all live here, in the
         transport-neutral core. That is what makes this example runnable without Kinesis or Event
         Hubs: the pipeline and its operators are the real ones, and only the source of a batch is
         local. -->
    <PackageReference Include="Benzene.Core.Middleware" />
    <PackageReference Include="Benzene.Core.MessageHandlers" />
    <PackageReference Include="Benzene.HostedService" />
    <PackageReference Include="Benzene.Http" />
    <PackageReference Include="Benzene.Microsoft.Dependencies" />
    <PackageReference Include="Benzene.SelfHost" />
  </ItemGroup>
</Project>
