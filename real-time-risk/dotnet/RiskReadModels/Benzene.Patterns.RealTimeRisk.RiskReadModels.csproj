<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- See TradeLedger's .csproj comment for why every Benzene.* package (direct and transitive) is
         pinned with the [version] exact-match syntax rather than a bare floor. -->
    <PackageReference Include="Benzene.AspNet.Core" Version="[0.0.2-alpha.3]" />
    <PackageReference Include="Benzene.Abstractions" Version="[0.0.2-alpha.3]" />
    <PackageReference Include="Benzene.Abstractions.MessageHandlers" Version="[0.0.2-alpha.3]" />
    <PackageReference Include="Benzene.Abstractions.Messages" Version="[0.0.2-alpha.3]" />
    <PackageReference Include="Benzene.Abstractions.Middleware" Version="[0.0.2-alpha.3]" />
    <PackageReference Include="Benzene.Abstrations.Pipelines" Version="[0.0.2-alpha.3]" />
    <PackageReference Include="Benzene.CodeGen.SourceGenerators" Version="[0.0.2-alpha.3]" />
    <PackageReference Include="Benzene.Core" Version="[0.0.2-alpha.3]" />
    <PackageReference Include="Benzene.Core.MessageHandlers" Version="[0.0.2-alpha.3]" />
    <PackageReference Include="Benzene.Core.Messages" Version="[0.0.2-alpha.3]" />
    <PackageReference Include="Benzene.Core.Middleware" Version="[0.0.2-alpha.3]" />
    <PackageReference Include="Benzene.Http" Version="[0.0.2-alpha.3]" />
    <PackageReference Include="Benzene.Microsoft.Dependencies" Version="[0.0.2-alpha.3]" />
    <PackageReference Include="Benzene.Results" Version="[0.0.2-alpha.3]" />
    <!-- No separate AWSSDK.DynamoDBStreams reference: that package didn't exist until AWS SDK v4 -
         under v3.7.x (which this pins to, matching Benzene.EventSourcing.DynamoDb's own reference -
         see TradeLedger's .csproj comment), IAmazonDynamoDBStreams/AmazonDynamoDBStreamsClient ship
         bundled inside AWSSDK.DynamoDBv2 itself. -->
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="3.7.301.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\Benzene.Patterns.RealTimeRisk.Contracts.csproj" />
  </ItemGroup>

</Project>
