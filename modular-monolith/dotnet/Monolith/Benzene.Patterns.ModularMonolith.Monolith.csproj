<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Benzene.AspNet.Core" />
    <PackageReference Include="Benzene.Clients" />
    <!-- The in-process transport is an ordinary, opt-in transport package - a fifth transport, not
         a magic co-location mode. Only the monolith host references it; the extracted services do
         not, because they do not have an in-process neighbour to route to. -->
    <PackageReference Include="Benzene.Clients.InProcess" />
    <PackageReference Include="Benzene.HostedService" />
    <PackageReference Include="Benzene.Http" />
    <PackageReference Include="Benzene.Microsoft.Dependencies" />
    <PackageReference Include="Benzene.SelfHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\Orders\Benzene.Patterns.ModularMonolith.Modules.Orders.csproj" />
    <ProjectReference Include="..\Modules\Billing\Benzene.Patterns.ModularMonolith.Modules.Billing.csproj" />
    <ProjectReference Include="..\Modules\Shipping\Benzene.Patterns.ModularMonolith.Modules.Shipping.csproj" />
  </ItemGroup>

</Project>
